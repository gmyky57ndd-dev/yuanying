# DeepSeek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (server-side, service role)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx

# Supabase direct Postgres (only for local migrations; NOT used by the app/Vercel)
# Project Settings -> Database -> Connection string
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.xxxx.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD

# GitHub feedback integration (ES-017). Set in Vercel + .env.local.
# Token needs repo Issues:write. Repo must exist; label "yuanying-feedback".
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=owner/yuanying-prototype

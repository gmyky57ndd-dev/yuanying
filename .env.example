# DeepSeek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional provider keys (used when a models row has no api_key)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google Drive read-only import (ES-030)
# Authorized redirect URI in Google Cloud:
#   https://<your-domain>/api/integrations/google-drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.vercel.app/api/integrations/google-drive/callback

# Optional: Tavily web search (ES-036). If absent, DuckDuckGo HTML is used.
TAVILY_API_KEY=

# Supabase (server-side, service role)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx

# Supabase direct Postgres (only for local migrations; NOT used by the app/Vercel)
# Project Settings -> Database -> Connection string
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.xxxx.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD

# GitHub feedback integration (ES-017). Set in Vercel + .env.local.
# Token needs repo Issues:write. Repo must exist; label "yuanying-feedback".
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=owner/yuanying-prototype


# ES-053: MCP bridge
# Token external MCP clients use to reach /api/mcp (falls back to API_TOKEN).
MCP_TOKEN=
# Optional external MCP server for ask_external_agent
MCP_EXTERNAL_URL=
MCP_EXTERNAL_TOKEN=

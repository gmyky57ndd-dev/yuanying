<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0c0a09">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="元婴采集器"
        android:textColor="#f5f5f4"
        android:textSize="24sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="采集手机使用数据，用于元婴的理解。数据仅本地和你的 Supabase，不外传。"
        android:textColor="#a8a29e"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="检查权限中…"
        android:textColor="#f5f5f4"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/open_pwa_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="启动元婴"
        android:layout_marginBottom="8dp" />

    <Switch
        android:id="@+id/overlay_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="开启悬浮元婴"
        android:textColor="#f5f5f4"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="悬浮窗会在其他应用之上显示一个小悟气泡，点击可快速记一句。"
        android:textColor="#78716c"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/grant_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="授予使用访问权限"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="若开关不可用（受限设置）：设置 → 应用 → 元婴采集器 → 右上角菜单 → 允许受限设置"
        android:textColor="#78716c"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/test_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="立即上报一次"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="步数采集（Health Connect）"
        android:textColor="#f5f5f4"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/steps_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="检查中…"
        android:textColor="#a8a29e"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/grant_steps_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="授予步数权限" />

    <Button
        android:id="@+id/update_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="更新到最新版"
        android:layout_marginTop="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="若应用商店没有更新提示，点上方按钮打开内测页面，即可拉取最新版。"
        android:textColor="#78716c"
        android:textSize="12sp"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/version_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#57534e"
        android:textSize="12sp"
        android:layout_marginTop="12dp" />

</LinearLayout>
